# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=sqlite:///./bidverify.db
# Docker Postgres:
# DATABASE_URL=postgresql+psycopg2://bidverify:bidverify@postgres:5432/bidverify

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24

UPLOAD_DIR=./uploads

# LLM provider: "mock" (default, deterministic demo), "openai" or "gemini"
# (free tier via Google AI Studio — same key also powers Gemini vision OCR).
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OCR engine for scanned PDFs: "paddle" (local, default) or "gemini"
# (Gemini vision API — needs GEMINI_API_KEY above).
OCR_PROVIDER=paddle

# Frontend
VITE_API_URL=http://localhost:8000/api
